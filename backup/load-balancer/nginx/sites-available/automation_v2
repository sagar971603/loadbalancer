upstream newtool2_backend {
    ip_hash;

    server 217.217.249.145:8000 max_fails=3 fail_timeout=30s;
    server 217.216.78.35:8000 max_fails=3 fail_timeout=30s;
    server 217.216.78.96:8000 max_fails=3 fail_timeout=30s;
    server 147.93.168.214:8000 max_fails=3 fail_timeout=30s;
    server 147.93.171.116:8000 max_fails=3 fail_timeout=30s;
    server 147.93.168.221:8000 max_fails=3 fail_timeout=30s;
    server 147.93.171.254:80 max_fails=3 fail_timeout=30s;

}

server {
    server_name newtool2.fskindia.com;

    access_log /var/log/nginx/automation_v2.access.log;
    error_log  /var/log/nginx/automation_v2.error.log;

    location / {
        proxy_pass http://newtool2_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 5s;
        proxy_send_timeout 90s;
        proxy_read_timeout 3600;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/newtool2.fskindia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/newtool2.fskindia.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name newtool2.fskindia.com;
    return 301 https://$host$request_uri;
}
