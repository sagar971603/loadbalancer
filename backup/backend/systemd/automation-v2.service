[Unit]
Description=Automation V2 FastAPI Playwright Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tools/automation-v2
EnvironmentFile=/root/tools/automation-v2/api/.env
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
ExecStart=/root/tools/automation-v2/venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8009 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
